# Совпадает с пользователем, паролем и БД в docker-compose.yml.
# Порт 5433 — публикация контейнера на хосте (внутри контейнера Postgres слушает 5432).
DATABASE_URL=postgres://delivery_user:root@localhost:5433/delivery?sslmode=disable

# Необязательно; если не заданы, используются значения по умолчанию.
# PORT=8080
# SERVER_READ_TIMEOUT=15s
# SERVER_WRITE_TIMEOUT=15s
# SERVER_IDLE_TIMEOUT=60s
# REQUEST_TIMEOUT=3s
